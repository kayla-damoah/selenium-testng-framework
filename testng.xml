<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- thread-count="1" runs one browser at a time. Raise it (e.g. 3) to run classes in parallel
     once the suite is stable and the machine has the CPU for several browsers. -->
<suite name="SauceDemo" parallel="classes" thread-count="1">
  <test name="Regression">
    <packages>
      <package name="com.kayla.qa.tests"/>
    </packages>
  </test>
</suite>
